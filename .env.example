# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret. Server only. Never share it or put it in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: turns on the Study Hub tutor and quiz maker. Set ONE of these.
# Free option: Google Gemini key from aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Paid option: Anthropic key from console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
